# Copy to `.env.local` for local development.
# Never commit real secrets.

# --- Maps (optional) ---
# Google Maps JavaScript API. Without this key, street maps use OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Local next-dev defaults to OSM. Set to 1 to try Google tiles when a key is set.
# NEXT_PUBLIC_USE_GOOGLE_MAPS=1

# Monthly free Dynamic Maps load budget used by the in-app circuit breaker (default 10000).
# GOOGLE_MAPS_MONTHLY_BUDGET=10000

# --- AI assistant (optional) ---
# Gemini API key for the dashboard trip assistant (server-side only).
GEMINI_API_KEY=

# Estimated free requests-per-day budget; app pauses AI near 98% until HK midnight (default 250).
# GEMINI_DAILY_BUDGET=250

# --- Routing (optional) ---
# Self-hosted OSRM base URL. If empty, the public OSRM demo server is used.
# OSRM_BASE_URL=https://router.project-osrm.org

# --- Long-lived corridor cache (optional) ---
# Vercel KV
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Or Upstash Redis REST
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Build stamp (optional; Vercel usually injects equivalents) ---
# NEXT_PUBLIC_APP_BUILD_ID=
